@model GerenciadorAcademico.ViewModels.NovoProjetoViewModel

@{
    ViewData["Title"] = "Cadastrar Projeto";
}

<h1>Cadastrar Projeto</h1>

<form asp-action="Cadastrar" method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger">
    </div>

    <partial name="_FormularioProjeto"
             model="(GerenciadorAcademico.ViewModels.ProjetoFormularioViewModel)Model" />

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">
            Cadastrar
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancelar
        </a>
    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
