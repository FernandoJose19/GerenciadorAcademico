@model GerenciadorAcademico.ViewModels.NovoProjetoViewModel

@{
    ViewData["Title"] = "Cadastrar projeto";
}

<h1>Cadastrar projeto</h1>

<form asp-action="Cadastrar" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Titulo" class="form-label">Título</label>
        <input asp-for="Titulo" class="form-control" />
        <span asp-validation-for="Titulo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Descricao"></label>

        <textarea asp-for="Descricao"
                  class="input"></textarea>

        <span asp-validation-for="Descricao"
              class="validation"></span>

    </div>

    <div class="mb-3">
        <label asp-for="CargaHoraria" class="form-label">Carga Horária</label>
        <input asp-for="CargaHoraria" class="form-control" />
        <span asp-validation-for="CargaHoraria" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Salvar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}