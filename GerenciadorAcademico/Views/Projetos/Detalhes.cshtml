@model GerenciadorAcademico.Models.Projeto

@{
    ViewData["Title"] = "Detalhes do Projeto";
}

<div class="page-heading">
    <div>
        <h1>Detalhes do Projeto</h1>
        <p>Visualize as informações do projeto acadêmico.</p>
    </div>

    <div>
        <a asp-action="Editar"
           asp-route-id="@Model.Id"
           class="button">
            Editar
        </a>

        <a asp-action="Index"
           class="button secondary">
            Voltar
        </a>
    </div>
</div>

<div class="details">

    <div class="detail-item">
        <strong>Título</strong>
        <p>@Model.Titulo</p>
    </div>

    <div class="detail-item">
        <strong>Descrição</strong>
        <p>@Model.Descricao</p>
    </div>

    <div class="detail-item">
        <strong>Carga horária</strong>
        <p>@Model.CargaHoraria horas</p>
    </div>

    <div class="detail-item">
        <strong>Professor</strong>
        <p>
            @if (Model.Professor is not null)
            {
                @Model.Professor.Nome
            }
            else
            {
                <span>Professor não informado</span>
            }
        </p>
    </div>

    <div class="detail-item">
        <strong>E-mail do professor</strong>
        <p>
            @if (Model.Professor is not null)
            {
                @Model.Professor.Email
            }
            else
            {
                <span>Não informado</span>
            }
        </p>
    </div>
    
</div>