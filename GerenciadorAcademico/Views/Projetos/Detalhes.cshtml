@model GerenciadorAcademico.Models.Projeto

@{
    ViewData["Title"] = "Detalhes do projeto";
}

<h1>Detalhes do projeto</h1>

<dl class="row">
    <dt class="col-sm-3">Título</dt>
    <dd class="col-sm-9">@Model.Titulo</dd>

    <dt class="col-sm-3">Descrição</dt>
    <dd class="col-sm-9">@Model.Descricao</dd>

    <dt class="col-sm-3">Carga horária</dt>
    <dd class="col-sm-9">@Model.CargaHoraria horas</dd>
</dl>

<a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Voltar</a>