@model GerenciadorAcademico.ViewModels.EditarProjetoViewModel

@{
    ViewData["Title"] = "Editar projeto";
}

<h1>Editar projeto</h1>

<form asp-action="Editar" method="post" class="form-card">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="validation"></div>

    <div>
        <label asp-for="Titulo"></label>
        <input asp-for="Titulo" class="input" />
        <span asp-validation-for="Titulo" class="validation"></span>
    </div>

    <div>
        <label asp-for="Descricao"></label>
        <textarea asp-for="Descricao" class="input"></textarea>
        <span asp-validation-for="Descricao" class="validation"></span>
    </div>

    <div>
        <label asp-for="CargaHoraria"></label>
        <input asp-for="CargaHoraria" class="input" />
        <span asp-validation-for="CargaHoraria" class="validation"></span>
    </div>

    <div class="form-actions">
        <button type="submit" class="button">Salvar alterações</button>
        <a asp-action="Index" class="button secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
